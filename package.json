{
  "name": "clip-video",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "author": "Ozelot <contact@ozelot.fyi> (https://ozelot.fyi/)",
  "description": "Clip - a private, local-first short-form video editor (Nuxt 4 SPA + Capacitor, plain JavaScript)",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt generate && node scripts/generate-precache.mjs",
    "generate": "nuxt generate && node scripts/generate-precache.mjs",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "vitest run",
    "test:watch": "vitest",
    "cap:sync": "npm run build && cap sync android",
    "cap:open": "cap open android",
    "android": "npm run build && cap sync android && cap run android",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/share": "^8.0.2",
    "@huggingface/transformers": "^4.3.0",
    "@pinia/nuxt": "^1.0.2",
    "idb": "^8.0.3",
    "immer": "^11.1.18",
    "lucide-vue-next": "^1.0.0",
    "mediabunny": "^1.57.0",
    "nuxt": "^4.5.2",
    "pinia": "^4.0.3",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@tailwindcss/vite": "^4.3.3",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "vitest": "^5.0.1"
  }
}
